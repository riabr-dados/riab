---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---

<Base title="Transformar mudou para Analisar" description="A ferramenta Transformar agora faz parte do ambiente Analisar do RIDAB.">
  <main class="legacy-route">
    <p class="legacy-route__label">Endereço preservado</p>
    <h1>Transformar agora faz parte de Analisar.</h1>
    <p>
      A montagem de cruzamentos, as receitas prontas e o diagrama de relações
      continuam disponíveis no ambiente unificado.
    </p>
    <a class="btn-primary" href={`${base}analisar/`}>Abrir Analisar</a>
  </main>

  <script define:vars={{ target: `${base}analisar/` }}>
    const suffix = `${window.location.search}${window.location.hash}`;
    window.location.replace(`${target}${suffix}`);
  </script>
</Base>

<style>
  .legacy-route { max-width: 760px; min-height: 62vh; margin: 0 auto; padding: clamp(64px, 10vw, 120px) 24px; }
  .legacy-route__label { margin-bottom: 16px; color: var(--br); font-family: var(--font-m); font-size: .75rem; }
  h1 { max-width: 650px; font-family: var(--font-d); font-size: clamp(2.4rem, 6vw, 5rem); line-height: .98; }
  .legacy-route > p:not(.legacy-route__label) { max-width: 610px; margin: 24px 0; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }
</style>
